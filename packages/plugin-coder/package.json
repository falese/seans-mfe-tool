{
  "name": "@seans-mfe/plugin-coder",
  "version": "0.1.0",
  "description": "First-party coder seam for seans-mfe-tool (coder:compile) — intent-compilation contract + DSL eval oracle (ADR-088)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "oclif.manifest.json"
  ],
  "scripts": {
    "build": "tsc && npx oclif manifest",
    "clean": "rm -rf dist oclif.manifest.json",
    "typecheck": "tsc --noEmit"
  },
  "oclif": {
    "commands": "./dist/commands",
    "bin": "seans-mfe-tool",
    "topics": {
      "coder": {
        "description": "Intent-compilation seam — compile a business intent into a DSL mfe-manifest via the external coder service (ADR-085/ADR-088)"
      }
    }
  },
  "peerDependencies": {
    "@oclif/core": "^4",
    "seans-mfe-tool": "^1"
  },
  "peerDependenciesMeta": {
    "seans-mfe-tool": {
      "optional": true
    }
  },
  "dependencies": {
    "@seans-mfe/contracts": "file:../contracts",
    "@seans-mfe/dsl": "file:../dsl",
    "@seans-mfe/oclif-base": "file:../oclif-base",
    "chalk": "^4.1.2",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@oclif/core": "^4.10.5",
    "@types/js-yaml": "^4.0.9",
    "oclif": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "license": "MIT"
}
