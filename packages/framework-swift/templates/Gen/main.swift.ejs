//
// manifest-metadata-gen — the executable the SPM build-tool plugin runs.
//
// Reads mfe-manifest.json (the CLI's projection of mfe-manifest.yaml) and
// writes ManifestMetadata.swift. This is the Swift half of "the manifest is
// read by two build systems and neither holds a copy of the truth" (ADR-095).

import Foundation

struct HookSpec: Decodable {
    let phase: String
    let hook: String
    let handlers: [String]
    let contained: Bool
}

struct Capability: Decodable {
    let name: String
    let type: String
    let description: String
    let lifecycle: [HookSpec]?
}

struct ManifestProjection: Decodable {
    let name: String
    let version: String
    let bundleId: String
    let bffEndpoint: String?
    let capabilities: [Capability]
}

let args = CommandLine.arguments
guard args.count == 3 else {
    FileHandle.standardError.write("usage: manifest-metadata-gen <manifest.json> <out.swift>\n".data(using: .utf8)!)
    exit(2)
}

let input = URL(fileURLWithPath: args[1])
let output = URL(fileURLWithPath: args[2])

let manifest: ManifestProjection
do {
    manifest = try JSONDecoder().decode(ManifestProjection.self, from: Data(contentsOf: input))
} catch {
    FileHandle.standardError.write("failed to read \(input.path): \(error)\n".data(using: .utf8)!)
    exit(1)
}

/// A Swift string literal for `s`.
///
/// Escapes control characters, not just `\` and `"`. A manifest `description:`
/// written with a YAML literal block (`|`) preserves its newlines, and a raw
/// newline inside a string literal is an unterminated-string error in a file
/// nobody hand-wrote. Anything else non-printable goes out as `\u{...}`.
func swiftString(_ s: String) -> String {
    var out = "\""
    for scalar in s.unicodeScalars {
        switch scalar {
        case "\\": out += "\\\\"
        case "\"": out += "\\\""
        case "\n": out += "\\n"
        case "\r": out += "\\r"
        case "\t": out += "\\t"
        case "\0": out += "\\0"
        default:
            // Swift string literals cannot carry a raw control character.
            if scalar.value < 0x20 || scalar.value == 0x7F {
                out += String(format: "\\u{%X}", scalar.value)
            } else {
                out.unicodeScalars.append(scalar)
            }
        }
    }
    return out + "\""
}

let domain = manifest.capabilities.filter { $0.type == "domain" }

// Flattened across capabilities: MFEBase filters by capability + phase, and a
// flat literal is what a build-time generator can emit without a parser.
let hooks = manifest.capabilities.flatMap { capability in
    (capability.lifecycle ?? []).map { spec -> String in
        let handlers = spec.handlers.map(swiftString).joined(separator: ", ")
        return "        MFEHookSpec(capability: \(swiftString(capability.name)), phase: .\(spec.phase), "
            + "hook: \(swiftString(spec.hook)), handlers: [\(handlers)], contained: \(spec.contained)),"
    }
}

var out = """
// Generated at build time by ManifestCodegen. Do not edit and do not commit.
import Foundation

public enum ManifestMetadata {
    public static let name = \(swiftString(manifest.name))
    public static let version = \(swiftString(manifest.version))
    public static let bundleId = \(swiftString(manifest.bundleId))
    public static let bffEndpoint: String? = \(manifest.bffEndpoint.map(swiftString) ?? "nil")

    public static let domainCapabilities: [String] = [
\(domain.map { "        \(swiftString($0.name))," }.joined(separator: "\n"))
    ]

    /// Manifest lifecycle hooks, flattened (ADR-040, ADR-098 §5).
    public static let hooks: [MFEHookSpec] = [
\(hooks.joined(separator: "\n"))
    ]

    public static let capabilities: [CapabilityMetadata] = [
\(manifest.capabilities.map { "        CapabilityMetadata(name: \(swiftString($0.name)), type: \(swiftString($0.type)), description: \(swiftString($0.description)))," }.joined(separator: "\n"))
    ]
}

"""

do {
    try out.write(to: output, atomically: true, encoding: .utf8)
} catch {
    FileHandle.standardError.write("failed to write \(output.path): \(error)\n".data(using: .utf8)!)
    exit(1)
}
