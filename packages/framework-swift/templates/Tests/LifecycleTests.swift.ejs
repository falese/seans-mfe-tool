    @Test func queryForwardsTheBearerTokenAndHeaders() async throws {
        let seen = SeenRequest()
        let transport: MFETransport = { request in
            await seen.record(request.allHTTPHeaderFields ?? [:])
            let response = HTTPURLResponse(
                url: request.url!, statusCode: 200, httpVersion: nil, headerFields: nil
            )!
            return (Data(#"{"data":{}}"#.utf8), response)
        }
        let mfe = <%= moduleName %>MFE(
            provider: StubProvider(),
            deps: MFEDependencies(transport: transport)
        )
        _ = try await mfe.load(MFEContext())
        _ = try await mfe.query(MFEContext(
            inputs: ["document": .string("query { x }"), "bffUrl": .string("http://stub.invalid/graphql")],
            jwt: "tok",
            headers: ["X-Request-Id": "abc"]
        ))
        let headers = await seen.headers
        #expect(headers["Authorization"] == "Bearer tok")
        #expect(headers["X-Request-Id"] == "abc")
        #expect(headers["Content-Type"] == "application/json")
    }

