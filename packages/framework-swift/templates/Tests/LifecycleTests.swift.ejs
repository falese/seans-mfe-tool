/// Records telemetry events, from any task.
private final class RecordingTelemetry: MFETelemetry, @unchecked Sendable {
    private let lock = NSLock()
    private var _events: [MFETelemetryEvent] = []
    var events: [MFETelemetryEvent] { lock.lock(); defer { lock.unlock() }; return _events }
    func emit(_ event: MFETelemetryEvent) { lock.lock(); _events.append(event); lock.unlock() }
}

/// A daemon client that records the mutation it is sent (ADR-102).
private final class StubControlPlane: MFEControlPlaneClient, @unchecked Sendable {
    let connected: Bool
    let answer: Result<Bool, Error>
    private let lock = NSLock()
    private var _sent: [(query: String, variables: [String: JSONValue])] = []
    var sent: [(query: String, variables: [String: JSONValue])] { lock.lock(); defer { lock.unlock() }; return _sent }

    init(connected: Bool, answer: Result<Bool, Error> = .success(true)) {
        self.connected = connected
        self.answer = answer
    }

    func mutation(_ query: String, variables: [String: JSONValue], timeoutMs: Int) async throws -> Bool {
        record(query, variables)
        return try answer.get()
    }

    // Synchronous, because NSLock is unavailable directly in async contexts
    // (an error in the Swift 6 language mode).
    private func record(_ query: String, _ variables: [String: JSONValue]) {
        lock.lock(); _sent.append((query, variables)); lock.unlock()
    }
}

