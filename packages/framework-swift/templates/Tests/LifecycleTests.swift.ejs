    // MARK: - query transport
    //
    // `doQuery` and `BFFClient` share one HTTP path (`GraphQLPost.send`) and
    // keep DIFFERENT error policies on purpose. Nothing else can observe that:
    // `check:mfe-drift` compares generated bytes to the template, so both files
    // stay "correct" while free to diverge. These run the real code over a stub
    // transport, so the split is asserted rather than incidental.

    /// A partial GraphQL response — `data` AND `errors`, a normal outcome.
    private static let partialResponse = Data(#"{"data":{"x":1},"errors":[{"message":"boom"}]}"#.utf8)

    private static func stub(_ body: Data, status: Int = 200) -> MFETransport {
        { request in
            let response = HTTPURLResponse(
                url: request.url!, statusCode: status, httpVersion: nil, headerFields: nil
            )!
            return (body, response)
        }
    }

