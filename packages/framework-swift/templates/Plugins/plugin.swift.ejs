import Foundation
import PackagePlugin

@main
struct ManifestCodegen: BuildToolPlugin {
    func createBuildCommands(context: PluginContext, target: Target) async throws -> [Command] {
        let manifest = context.package.directory.appending("mfe-manifest.json")
        let output = context.pluginWorkDirectory.appending("ManifestMetadata.swift")

        return [
            .buildCommand(
                displayName: "Generating ManifestMetadata.swift from mfe-manifest.json",
                executable: try context.tool(named: "ManifestMetadataGen").path,
                arguments: [manifest.string, output.string],
                inputFiles: [manifest],
                outputFiles: [output]
            )
        ]
    }
}
