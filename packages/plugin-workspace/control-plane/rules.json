[
  {
    "registration": {
      "name": "decomposition-workspace",
      "version": "1.0.0",
      "type": "remote",
      "baseUrl": "http://localhost:4611",
      "capabilities": [
        "load",
        "render"
      ],
      "contentType": "module-federation",
      "remoteEntryUrl": "http://localhost:4611/remoteEntry.js",
      "moduleFederation": {
        "scope": "decomposition_workspace",
        "module": "./App"
      }
    },
    "routes": [
      {
        "when": {
          "stateKey": "smt-tools.decomposition.map"
        },
        "resolve": {
          "capability": "ProposalMap",
          "props": {
            "slot": "root"
          }
        }
      },
      {
        "when": {
          "stateKey": "smt-tools.decomposition.shape"
        },
        "resolve": {
          "capability": "ShapeProposal",
          "props": {
            "slot": "root"
          }
        }
      },
      {
        "when": {
          "stateKey": "smt-tools.decomposition.agent"
        },
        "resolve": {
          "capability": "AgentPane",
          "props": {
            "slot": "root"
          }
        }
      },
      {
        "when": {
          "stateKey": "smt-tools.decomposition.approve"
        },
        "resolve": {
          "capability": "ApproveProposal",
          "props": {
            "slot": "root"
          }
        }
      }
    ]
  }
]
