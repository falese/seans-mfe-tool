{
  "name": "@falese/smt-runtime",
  "version": "0.1.0",
  "description": "Runtime: BaseMFE/RemoteMFE lifecycle classes consumed by generated MFEs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "react.js",
    "react.d.ts",
    "angular.js",
    "angular.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "default": "./dist/angular.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falese/seans-mfe-tool.git",
    "directory": "packages/runtime"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
