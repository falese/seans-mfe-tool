{
  "name": "@falese/smt-framework-angular",
  "version": "0.1.0",
  "description": "Angular + webpack framework plugin for seans-mfe-tool (ADR-071)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "require": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    }
  },
  "files": [
    "dist",
    "runtime.js",
    "runtime.d.ts"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@falese/smt-contracts": "^0.1.0"
  },
  "peerDependencies": {
    "@angular/core": "^17.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "^17.3.12",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falese/seans-mfe-tool.git",
    "directory": "packages/framework-angular"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
