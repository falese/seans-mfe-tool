{
  "name": "@seans-mfe/plugin-api",
  "version": "0.1.0",
  "description": "OpenAPI -> Express + MongoDB/SQLite backend generator for seans-mfe-tool (ADR-063)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "templates",
    "oclif.manifest.json"
  ],
  "scripts": {
    "build": "tsc && npx oclif manifest",
    "clean": "rm -rf dist oclif.manifest.json",
    "typecheck": "tsc --noEmit"
  },
  "oclif": {
    "commands": "./dist/commands",
    "bin": "seans-mfe-tool",
    "topics": {
      "api": {
        "description": "Generate a REST API backend from an OpenAPI specification (ADR-063)"
      }
    }
  },
  "peerDependencies": {
    "@oclif/core": "^4",
    "seans-mfe-tool": "^1"
  },
  "peerDependenciesMeta": {
    "seans-mfe-tool": {
      "optional": true
    }
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@seans-mfe/contracts": "file:../contracts",
    "@seans-mfe/oclif-base": "file:../oclif-base",
    "chalk": "^4.1.2",
    "ejs": "^3.1.10",
    "fs-extra": "^11.2.0",
    "openapi-types": "^12.1.3"
  },
  "devDependencies": {
    "@oclif/core": "^4.10.5",
    "oclif": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "license": "MIT"
}
