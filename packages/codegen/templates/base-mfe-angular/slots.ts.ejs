/**
 * Slot contract for <%= name %> — GENERATED from mfe-manifest `providesSlots`.
 * Do not edit: regenerate after changing the manifest.
 *
 * Three-layer split (ADR-067): this file is the DATA layer — the manifest
 * mirrored into code and bound to the framework-free contract logic in
 * @falese/smt-runtime. Matching and the declare-before-register guard
 * live there, once; the DeclaredSlotDirective below is thin sugar with no
 * logic of its own. Ids are assigned names, never positions (ADR-066);
 * renaming one is a manifest diff — a contract change, not a string edit.
 */
import { Directive, Input } from '@angular/core';
import { createSlotContract } from '@falese/smt-runtime';
import type { ProvidedSlotDeclaration } from '@falese/smt-runtime';
import { DeclaredSlotDirective as BaseDeclaredSlotDirective } from '@falese/smt-framework-angular/runtime';

/** The manifest's providesSlots section, mirrored into code. */
export const PROVIDED_SLOTS: readonly ProvidedSlotDeclaration[] = [
<%_ providesSlots.forEach(function(slot) { _%>
  { id: <%- JSON.stringify(slot.id) %><% if (slot.description) { %>, description: <%- JSON.stringify(slot.description) %><% } %> },
<%_ }); _%>
] as const;

/** This MFE's slot contract: matching + declare-before-register guard. */
export const slotContract = createSlotContract(PROVIDED_SLOTS);

/** Host registration callback (ADR-058). */
export type ProvideSlotFn = (slotId: string, element: HTMLElement | null) => void;

/**
 * The ids this MFE may register (ADR-072). Renaming a slot in the manifest
 * makes every stale use site a compile error instead of a runtime throw.
 * A `{param}` segment becomes `${string}`, so a keyed id type-checks by
 * interpolation: `` `berth.${berthId}` ``.
 *
 * Looser than the runtime matcher by necessity — TypeScript cannot express
 * "a string with no dot" — so `assertDeclared()` remains the backstop.
 */
export type DeclaredSlotId = <%- declaredSlotIdUnion %>;

/**
 * A named region this MFE contributes to the host layout. Drop the attribute on
 * the region element:
 *
 *   <div [smtDeclaredSlot]="'main'" [provideSlot]="provideSlot"></div>
 *
 * Registration rides Angular's element lifecycle; re-registration on remount is
 * safe because the host re-binds the address's desired experience instead of
 * destroying it (ADR-066).
 *
 * This is the app-code API for providing a slot (ADR-072). `slotContract` stays
 * public as the framework-adaptor escape hatch, but feature code should reach
 * for this directive so every region registers the same way.
 *
 * A binding, not a copy: the directive lives once in
 * `@falese/smt-framework-angular` and is extended here (ADR-084), exactly as the
 * React template binds `DeclaredSlot`. This file used to inline the whole class
 * — lifecycle hooks, release/re-register bookkeeping and all — under a comment
 * asking the next editor to keep it in lock-step with the published copy by
 * hand. Nothing enforced that. What stays generated is the part that genuinely
 * varies per manifest: the contract, pre-bound below, and the `DeclaredSlotId`
 * union that narrows `id` from `string` to this manifest's own slots.
 */
@Directive({
  selector: '[smtDeclaredSlot]',
  standalone: true,
})
export class DeclaredSlotDirective extends BaseDeclaredSlotDirective {
  /**
   * Narrowed from the base's `string` to the ids this manifest declares, so a
   * manifest rename is a compile error at every use site (ADR-072).
   *
   * Redeclaring the input is safe here because the generated Angular tsconfig
   * sets `useDefineForClassFields: false` — under define semantics this would
   * be TS2612, an uninitialised redeclaration overwriting the base property
   * with `undefined` at construction.
   */
  @Input('smtDeclaredSlot') override id!: DeclaredSlotId;

  /** Pre-bound, so provider components pass only `id` and `provideSlot`. */
  override contract = slotContract;
}
