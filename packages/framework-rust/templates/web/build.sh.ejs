#!/usr/bin/env bash
# Generated by seans-mfe-tool. Do not edit — regenerated on every `remote:generate`.
#
# Build the browser remote (ADR-100): compile to wasm32, run wasm-bindgen, and
# leave a servable directory at www/ (remoteEntry.js + pkg/). Serve www/ at
# the URL the placement rule's remoteEntryUrl points to.
#
# Needs: rustup target add wasm32-unknown-unknown
#        cargo install wasm-bindgen-cli --version <the version pinned in Cargo.toml>
set -euo pipefail
cd "$(dirname "$0")"

TARGET_DIR="${CARGO_TARGET_DIR:-target}"
cargo build --release --target wasm32-unknown-unknown

want="$(grep -A1 '^name = "wasm-bindgen"$' Cargo.lock | sed -n 's/^version = "\(.*\)"$/\1/p')"
have="$(wasm-bindgen --version 2>/dev/null | awk '{print $2}')"
if [[ -z "$have" ]]; then
  echo "build.sh: wasm-bindgen CLI not found. Install it: cargo install wasm-bindgen-cli --version $want" >&2
  exit 1
fi
if [[ "$want" != "$have" ]]; then
  echo "build.sh: wasm-bindgen CLI is $have but the crate uses $want. Install the matching CLI: cargo install wasm-bindgen-cli --version $want" >&2
  exit 1
fi

wasm-bindgen --target web --out-dir www/pkg --out-name mfe \
  "$TARGET_DIR/wasm32-unknown-unknown/release/<%- libName %>_web.wasm"
echo "build.sh: www/ is ready — serve it and point a placement at www/remoteEntry.js (scope <%- wasmScope %>, module ./App)."
