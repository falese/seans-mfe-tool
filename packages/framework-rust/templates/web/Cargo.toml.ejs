# Seeded once by seans-mfe-tool, then yours — add dependencies freely.
#
# The browser build of this MFE (ADR-100): the crate one directory up,
# compiled to WebAssembly and served as a Module Federation remote.
#
# `wasm-bindgen` is pinned EXACTLY because the `wasm-bindgen` CLI that
# post-processes the .wasm must be the same version as this crate — a mismatch
# fails at build time with a schema-version error. Bump both together:
#   cargo install wasm-bindgen-cli --version <same version>

[package]
name = "<%- crateName %>-web"
version = "<%- manifestVersion %>"
edition = "<%- edition %>"
# 1.77, not the native crate's 1.75: wasm-bindgen 0.2.128 needs it.
rust-version = "<%- edition === '2024' ? '1.85' : '1.77' %>"
publish = false

[lib]
crate-type = ["cdylib", "rlib"]
path = "src/lib.rs"

[dependencies]
<%- crateName %> = { path = ".." }
serde_json = "1"
wasm-bindgen = "=0.2.128"
wasm-bindgen-futures = "0.4"
web-sys = { version = "0.3", features = ["Document", "Element", "Node"] }
