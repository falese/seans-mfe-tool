    /// The capability pipeline, in the order `BaseMFE.executeCapability`
    /// composes it:
    ///
    /// 1. stateGuard(preStates)
    /// 2. stateTransition(enterState)
    /// 3. errorBoundary(capability, errorState) — wraps 4 to 8
    /// 4. lifecyclePhase(before)
    /// 5. lifecyclePhase(main)
    /// 6. the `do_*` hook
    /// 7. lifecyclePhase(after)
    /// 8. stateTransition(exitState)
    ///
    /// Written as eight steps in sequence rather than a composed middleware
    /// list: async closures that borrow across `.await` do not compose in Rust
    /// without boxing every step, and the order — which is the contract — reads
    /// the same either way. The error boundary sits AFTER the guard and the
    /// enter-transition on purpose: an invalid-state or invalid-transition
    /// error propagates without running the error phase or the error state.
    async fn execute<T, F, Fut>(&self, capability: MfeCapability, context: MfeContext, body: F) -> Result<T, MfeError>
    where
        F: FnOnce(MfeContext) -> Fut,
        Fut: Future<Output = Result<T, MfeError>>,
    {
        let mut context = context;
        context.capability = Some(capability.as_str().to_string());

        // 1.
        self.assert_state(capability, Some(&context))?;
        // 2.
        if let Some(enter) = capability.enter_state() {
            self.transition(enter, capability)?;
        }
        // 3.
        match self.guarded(capability, &mut context, body).await {
            Ok(value) => Ok(value),
            Err(error) => {
                let mut error_context = context.clone();
                error_context.error = Some(error.clone());
                let _ = self.execute_lifecycle(capability, MfeLifecyclePhase::Error, &mut error_context).await;
                if let Some(error_state) = capability.error_state() {
                    if self.state() != error_state {
                        let _ = self.transition(error_state, capability);
                    }
                }
                Err(error)
            }
        }
    }

    /// Steps 4 to 8 — everything the error boundary wraps.
    async fn guarded<T, F, Fut>(&self, capability: MfeCapability, context: &mut MfeContext, body: F) -> Result<T, MfeError>
    where
        F: FnOnce(MfeContext) -> Fut,
        Fut: Future<Output = Result<T, MfeError>>,
    {
        // 4.
        self.execute_lifecycle(capability, MfeLifecyclePhase::Before, context).await?;
        // 5.
        self.execute_lifecycle(capability, MfeLifecyclePhase::Main, context).await?;
        // 6.
        let mut body_context = context.clone();
        body_context.phase = None;
        let value = body(body_context).await?;
        // 7.
        self.execute_lifecycle(capability, MfeLifecyclePhase::After, context).await?;
        // 8.
        if let Some(exit) = capability.exit_state() {
            self.transition(exit, capability)?;
        }
        Ok(value)
    }

    // ---- The hook engine (ADR-002, rendered — ADR-098 §2)

    /// Run every hook the manifest declares for one capability phase.
    ///
    /// Skips rather than fails on re-entrancy (ADR-001): the re-entrant call
    /// is the bug, but the outer call is usually work a user is waiting on.
    async fn execute_lifecycle(
        &self,
        capability: MfeCapability,
        phase: MfeLifecyclePhase,
        context: &mut MfeContext,
    ) -> Result<(), MfeError> {
        let hooks = Self::find_capability_hooks(capability.as_str(), phase);
        if hooks.is_empty() {
            return Ok(());
        }

        let key = format!("{}:{}", capability.as_str(), phase.as_str());
        {
            let mut stack = lock(&self.lifecycle_stack);
            if stack.contains(&key) {
                return Ok(());
            }
            stack.push(key);
        }
        let _guard = StackGuard { stack: &self.lifecycle_stack };

        context.phase = Some(phase);
        context.capability = Some(capability.as_str().to_string());

        for hook in hooks {
            self.execute_hook(hook, context, phase).await?;
        }
        Ok(())
    }

    /// The manifest's hooks for one capability+phase.
    ///
    /// CASE-INSENSITIVE: `MfeCapability::Load.as_str()` is "load", the
    /// manifest writes "Load", and `BaseMFE.findCapabilityConfig` lowercases
    /// both sides. The Swift lane compared exactly at first and every manifest
    /// hook was inert (ADR-098 §Boundaries).
    fn find_capability_hooks(capability: &str, phase: MfeLifecyclePhase) -> Vec<&'static MfeHookSpec> {
