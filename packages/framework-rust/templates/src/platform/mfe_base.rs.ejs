/// Run a GraphQL document against this MFE's BFF.
///
/// Endpoint resolution, in the order ADR-053 fixes, as the Swift lane renders
/// it (ADR-096 §7):
///
/// 1. `context.inputs["bffUrl"]`
/// 2. the `BFF_URL` environment variable
/// 3. `identity.bff_endpoint` — the manifest's, baked at generation
///
/// An MFE with no endpoint answers `data: None` rather than dialing nothing,
/// which is what makes the capability uniform across every MFE (ADR-070).
pub async fn default_do_query(core: &MfeCore, context: &MfeContext) -> Result<QueryResult, MfeError> {
    let target = context
        .inputs
        .get("bffUrl")
        .and_then(Value::as_str)
        .map(str::to_string)
        .or_else(|| std::env::var("BFF_URL").ok())
        .or_else(|| core.identity().bff_endpoint.clone())
        .filter(|t| !t.is_empty());
    let Some(target) = target else {
        return Ok(QueryResult { data: None, errors: Vec::new() });
    };
    let Some(document) = context.inputs.get("document").and_then(Value::as_str) else {
        return Ok(QueryResult {
            data: None,
            errors: vec!["context.inputs[\"document\"] is required for the query capability".to_string()],
        });
    };

    let mut headers = context.headers.clone();
    if let Some(jwt) = &context.jwt {
        headers.insert("Authorization".to_string(), format!("Bearer {}", jwt));
    }

    let mut payload = Map::new();
    payload.insert("query".to_string(), Value::String(document.to_string()));
    if let Some(variables) = context.inputs.get("variables") {
        payload.insert("variables".to_string(), variables.clone());
    }
    let request = serde_json::to_vec(&Value::Object(payload)).map_err(|e| MfeError::Decode { message: e.to_string() })?;

    let body = match GraphQlPost::send(core.deps().transport.as_deref(), &target, request, &headers).await {
        Ok(body) => body,
        // The envelope policy: `query` answers with errors, it does not fail.
        // `BffClient::query` fails on the same input — the deliberate half of
        // the difference between the two.
        Err(error) => return Ok(QueryResult { data: None, errors: vec![error.to_string()] }),
    };

    let decoded: Value = serde_json::from_slice(&body).map_err(|e| MfeError::Decode { message: e.to_string() })?;
    let errors = graphql_error_messages(&decoded);
    // Partial responses carry both, and the capability returns both.
    let data = decoded.get("data").filter(|d| !d.is_null()).cloned();
    Ok(QueryResult { data, errors })
}

/// The `message` of every entry in a GraphQL response's `errors` array.
pub fn graphql_error_messages(response: &Value) -> Vec<String> {
    response
        .get("errors")
        .and_then(Value::as_array)
        .map(|list| {
            list.iter()
                .filter_map(|e| e.get("message").and_then(Value::as_str).map(str::to_string))
                .collect()
        })
        .unwrap_or_default()
}

