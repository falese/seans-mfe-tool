    /// One hook's handlers, in order (REQ-045).
    ///
    /// `contained` reports and swallows (REQ-042). A main-phase failure
    /// propagates; before/after/error continue to the next handler (REQ-042,
    /// REQ-045). Every failure reports (REQ-043).
    async fn execute_hook(&self, hook: &MfeHookSpec, context: &MfeContext, phase: MfeLifecyclePhase) -> Result<(), MfeError> {
        for name in hook.handlers {
            if let Err(error) = self.invoke_handler(name, context).await {
                if hook.contained {
                    self.emit_hook_failure(hook.hook, name, &error, context, "warn");
                    continue;
