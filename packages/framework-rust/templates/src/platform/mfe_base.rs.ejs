pub struct MfeBase<H: MfeHooks> {
    core: MfeCore,
    hooks: H,
}

impl<H: MfeHooks> MfeBase<H> {
    pub fn from_parts(hooks: H, identity: MfeIdentity, deps: MfeDependencies) -> Self {
        MfeBase { core: MfeCore::new(identity, deps), hooks }
    }

    /// Current lifecycle state.
    pub fn state(&self) -> MfeLifecycleState {
        self.core.state()
    }

    pub fn core(&self) -> &MfeCore {
        &self.core
    }

    pub fn hooks(&self) -> &H {
        &self.hooks
    }

