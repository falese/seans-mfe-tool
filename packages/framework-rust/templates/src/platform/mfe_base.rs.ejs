/// abstract (ADR-053, ADR-070).
pub trait MfeHooks: Send + Sync {
<% platformCapabilities.forEach(function (c) { -%>
<%_ if (c.name !== 'query') { _%>
    fn do_<%- c.snake %><'a>(&'a self, core: &'a MfeCore, context: &'a MfeContext) -> BoxFuture<'a, Result<<%- c.rustResult %>, MfeError>>;
<%_ } _%>
<% }); -%>

    fn do_query<'a>(&'a self, core: &'a MfeCore, context: &'a MfeContext) -> BoxFuture<'a, Result<QueryResult, MfeError>> {
