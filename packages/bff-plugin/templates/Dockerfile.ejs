# syntax=docker/dockerfile:1
# <%= name %> BFF
# Generated by seans-mfe-tool
# Following ADR-012: GraphQL Mesh with DSL-embedded configuration
# Build context: this MFE's own directory
#
# The syntax directive above is required for the `--mount=type=cache` on the
# install step. Without it BuildKit rejects the flag rather than ignoring it.

# Build tools stage — provides seans-mfe-tool CLI and pre-compiled runtime
FROM seans-mfe-tool-cli:latest AS cli-builder

FROM node:20-slim AS builder

WORKDIR /app

# Make the pre-compiled runtime available at a stable path inside the image.
# Using dist/runtime (compiled .js + .d.ts) avoids traversing TypeScript source
# and its transitive deps (zod, dsl/schema, etc.) during ng build / rspack.
COPY --from=cli-builder /seans-mfe-tool /seans-mfe-tool
RUN chmod +x /seans-mfe-tool/bin/run.js && \
    ln -sf /seans-mfe-tool/bin/run.js /usr/local/bin/seans-mfe-tool

# Install dependencies, then stage the pre-compiled runtime as a REAL
# directory inside node_modules. A file: dep would install as a symlink,
# module resolution would escape the project (real path /seans-mfe-tool),
# and framework imports inside the runtime — @angular/platform-browser,
# react — would fail to resolve during ng build / rspack.
COPY package.json ./
RUN npm pkg delete dependencies['@seans-mfe-tool/runtime'] 2>/dev/null || true && \
    npm pkg delete devDependencies['@seans-mfe-tool/runtime'] 2>/dev/null || true
# The npm download cache lives in a shared BuildKit cache mount rather than in
# this layer (#347). Without it every MFE's builder stage carries its own full
# copy — ~850 packages each across a 13-service fleet — and a sequential fleet
# build exhausts the disk partway through with ENOSPC while fetching, which
# reads as a package problem rather than a capacity one.
#
# The mount is shared across services and across builds: it survives
# `docker builder prune` only as far as the cache is kept, and is never part of
# the produced image.
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm install --legacy-peer-deps --no-audit --no-fund
RUN mkdir -p node_modules/@seans-mfe-tool && \
    cp -r /seans-mfe-tool/dist/runtime node_modules/@seans-mfe-tool/runtime

# Copy source files
COPY . .
<% if (includeStatic) { %>
# Build MFE static assets (rspack/webpack + seans-mfe-tool remote:generate).
RUN npm run build
<% } %>
# Build GraphQL Mesh artifacts (.mesh/ directory).
# createBuiltMeshHTTPHandler reads from .mesh/ at server startup — this step
# must run after COPY so specs/ and .meshrc.yaml are present in the build context.
# Runs unconditionally: for standalone BFF this is the only mesh build step;
# for combined MFE+BFF the npm run build above may already run it, but an
# explicit layer here makes the Mesh build visible and guarantees .mesh/ exists.
RUN npx mesh build
# Compile TypeScript server entry point.
RUN npm run build:server

# Strip @seans-mfe-tool/runtime from package.json before the production stage.
# remote:generate (called inside npm run build) rewrites package.json and may
# put the runtime back as a file: reference pointing to /seans-mfe-tool which
# doesn't exist in the production image — causing npm install to 404.
RUN npm pkg delete dependencies['@seans-mfe-tool/runtime'] 2>/dev/null || true && \
    npm pkg delete devDependencies['@seans-mfe-tool/runtime'] 2>/dev/null || true

# Production image
FROM node:20-slim AS production

WORKDIR /app

# Copy node_modules from builder — the .mesh/index.js requires @graphql-mesh/http,
# @graphql-mesh/runtime, etc., which are transitive deps of @graphql-mesh/cli
# (devDep) and not installed by a production --omit=dev install.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./
# Copy Mesh artifacts
COPY --from=builder /app/.mesh ./.mesh

# Copy BFF platform files dynamically imported by the built Mesh artifacts at runtime.
# .mesh/index.js resolves these relative to the project root via the paths in .meshrc.yaml.
COPY --from=builder /app/src/platform/bff/mesh-context.js ./src/platform/bff/
<%_ if (meshTransforms.mockSwitch) { _%>
COPY --from=builder /app/src/platform/bff/mock-switch.js ./src/platform/bff/
COPY --from=builder /app/src/platform/bff/mocks.json ./src/platform/bff/
<%_ } _%>
<% if (includeStatic) { %>
# Copy built static assets
COPY --from=builder /app/dist ./dist
<% } %>
# Copy compiled server
COPY --from=builder /app/server.js ./

# Health check — uses PORT env var so compose can override the default port
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:' + (process.env.PORT || <%= port %>) + '/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"

# Non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 meshuser
USER meshuser

ENV PORT=<%= port %>
EXPOSE <%= port %>

CMD ["node", "server.js"]
