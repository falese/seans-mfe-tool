{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "packages/contracts/src/index.ts",
    "packages/dsl/src/index.ts",
    "packages/codegen/src/index.ts",
    "packages/runtime/src/index.ts",
    "packages/runtime/src/react.ts",
    "packages/runtime/src/angular.ts"
  ],
  "tsconfig": "tsconfig.typedoc.json",
  "plugin": [
    "typedoc-plugin-markdown"
  ],
  "out": "docs/api",
  "cleanOutputDir": true,
  "readme": "none",
  "name": "seans-mfe-tool API reference",
  "includeVersion": false,
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "hideGenerator": true,
  "gitRevision": "main",
  "sourceLinkTemplate": "https://github.com/falese/seans-mfe-tool/blob/{gitRevision}/{path}#L{line}",
  "exclude": [
    "**/__tests__/**",
    "**/*.test.ts"
  ]
}
