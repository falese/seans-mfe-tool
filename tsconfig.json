{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "allowJs": true,
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "types": ["node", "jest"],
    "paths": {
      "@seans-mfe/contracts": ["./packages/contracts/src/index.ts"],
      "@seans-mfe/contracts/*": ["./packages/contracts/src/*"],
      "@seans-mfe/dsl": ["./packages/dsl/src/index.ts"],
      "@seans-mfe/dsl/*": ["./packages/dsl/src/*"],
      "@seans-mfe/codegen": ["./packages/codegen/src/index.ts"],
      "@seans-mfe/codegen/*": ["./packages/codegen/src/*"],
      "@seans-mfe/oclif-base": ["./packages/oclif-base/src/index.ts"],
      "@seans-mfe/oclif-base/*": ["./packages/oclif-base/src/*"],
      "@seans-mfe/plugin-bff": ["./packages/plugin-bff/src/index.ts"],
      "@seans-mfe/plugin-bff/*": ["./packages/plugin-bff/src/*"],
      "@seans-mfe/framework-react": ["./packages/framework-react/src/index.ts"],
      "@seans-mfe/framework-react/*": ["./packages/framework-react/src/*"],
      "@seans-mfe/framework-angular": ["./packages/framework-angular/src/index.ts"],
      "@seans-mfe/plugin-api": ["./packages/plugin-api/src/index.ts"],
      "@seans-mfe/plugin-api/*": ["./packages/plugin-api/src/*"],
      "@seans-mfe/plugin-adr": ["./packages/plugin-adr/src/index.ts"],
      "@seans-mfe/plugin-adr/*": ["./packages/plugin-adr/src/*"],
      "@seans-mfe/framework-angular/*": ["./packages/framework-angular/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/__tests__/**", "examples"]
}
