{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "allowJs": true,
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "types": ["node", "jest"],
    "paths": {
      "@falese/smt-contracts": ["./packages/contracts/src/index.ts"],
      "@falese/smt-contracts/*": ["./packages/contracts/src/*"],
      "@falese/smt-dsl": ["./packages/dsl/src/index.ts"],
      "@falese/smt-dsl/*": ["./packages/dsl/src/*"],
      "@falese/smt-codegen": ["./packages/codegen/src/index.ts"],
      "@falese/smt-codegen/*": ["./packages/codegen/src/*"],
      "@falese/smt-oclif-base": ["./packages/oclif-base/src/index.ts"],
      "@falese/smt-oclif-base/*": ["./packages/oclif-base/src/*"],
      "@falese/smt-plugin-bff": ["./packages/bff-plugin/src/index.ts"],
      "@falese/smt-plugin-bff/*": ["./packages/bff-plugin/src/*"],
      "@falese/smt-framework-react": ["./packages/framework-react/src/index.ts"],
      "@falese/smt-framework-react/*": ["./packages/framework-react/src/*"],
      "@falese/smt-framework-angular": ["./packages/framework-angular/src/index.ts"],
      "@falese/smt-framework-angular/*": ["./packages/framework-angular/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/__tests__/**", "examples"]
}
