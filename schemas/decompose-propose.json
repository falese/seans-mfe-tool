{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seans-mfe.dev/schemas/decompose:propose.json",
  "title": "decompose:propose",
  "description": "Propose a decomposition from decompose:analyze output — candidate domains with per-signal evidence, shared files, couplings, slots, routes and test triage — and derive validated MFE manifests and a composition. --from re-derives after the proposal is edited (ADR-110).",
  "input": {
    "type": "object",
    "properties": {
      "analysis": {
        "type": "string",
        "description": "Directory holding decompose:analyze output (an evidence bundle's source/, or its --out)"
      },
      "out": {
        "type": "string",
        "description": "Directory to write the proposal and derived fleet (default: <analysis>/../proposal)"
      },
      "name": {
        "type": "string",
        "description": "Prefix for MFE names (default: the app's package name)"
      },
      "namespace": {
        "type": "string",
        "description": "Control-plane namespace (default: the name)"
      },
      "from": {
        "type": "string",
        "description": "An edited decomposition.yaml to re-derive from, instead of clustering"
      },
      "evidence": {
        "type": "string",
        "description": "The decompose:capture bundle whose recorded traffic the BFF specs are inferred from (default: the parent of the analysis directory, or of the proposal with --from)"
      },
      "spec": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "backend=path — a published OpenAPI document for a backend; it is used instead of the inferred one (ADR-112 §3)"
      }
    },
    "required": [],
    "x-positional": [
      "analysis"
    ]
  },
  "output": {
    "type": "object",
    "required": [
      "outDir",
      "mode",
      "domains",
      "shared",
      "unassigned",
      "couplings",
      "tests",
      "uncovered",
      "validation",
      "valid",
      "specs",
      "files"
    ],
    "properties": {
      "outDir": {
        "type": "string"
      },
      "mode": {
        "type": "string",
        "enum": [
          "clustered",
          "rederived"
        ]
      },
      "domains": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "mfe",
            "files",
            "capabilities",
            "backends"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "mfe": {
              "type": "string"
            },
            "files": {
              "type": "number"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "backends": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "shared": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "unassigned": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "couplings": {
        "type": "number"
      },
      "tests": {
        "type": "object",
        "required": [
          "keep",
          "rewrite",
          "discard"
        ],
        "properties": {
          "keep": {
            "type": "number"
          },
          "rewrite": {
            "type": "number"
          },
          "discard": {
            "type": "number"
          }
        },
        "additionalProperties": false
      },
      "uncovered": {
        "type": "number"
      },
      "validation": {
        "type": "object",
        "required": [
          "manifests",
          "composition"
        ],
        "properties": {
          "manifests": {
            "type": "object"
          },
          "composition": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "rule",
                "message"
              ],
              "properties": {
                "rule": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false,
        "description": "Manifest errors per MFE and fatal composition findings; empty when everything validates."
      },
      "valid": {
        "type": "boolean"
      },
      "specs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "backend",
            "source",
            "operations",
            "errors"
          ],
          "properties": {
            "backend": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "enum": [
                "inferred",
                "published"
              ]
            },
            "operations": {
              "type": "number"
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "OpenAPI validation errors; empty when the document is valid."
            },
            "differences": {
              "type": "object",
              "required": [
                "operationsMatched",
                "inferredOnly",
                "publishedOnly",
                "fieldsMatched",
                "fieldsInferredOnly",
                "fieldsPublishedOnly",
                "typeMismatches"
              ],
              "properties": {
                "operationsMatched": {
                  "type": "number"
                },
                "inferredOnly": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "publishedOnly": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "fieldsMatched": {
                  "type": "number"
                },
                "fieldsInferredOnly": {
                  "type": "number"
                },
                "fieldsPublishedOnly": {
                  "type": "number"
                },
                "typeMismatches": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "description": "One OpenAPI document per backend the BFFs front (ADR-112); empty when there was no traffic or spec to read."
      },
      "files": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  },
  "errorCodes": [
    0,
    1,
    2,
    64,
    65,
    66,
    69,
    70,
    77,
    124
  ]
}
