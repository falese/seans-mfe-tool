{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seans-mfe.dev/schemas/flow:status.json",
  "title": "flow:status",
  "description": "Show where a directory stands in an SMT flow — which steps are done, stale or waiting on a person — and the next command to run, with its arguments filled in (PDR-012).",
  "input": {
    "type": "object",
    "properties": {
      "dir": {
        "type": "string",
        "description": "The flow's directory (for decompose: the evidence bundle)",
        "default": "."
      },
      "flow": {
        "type": "string",
        "description": "The flow (decompose); may be left out while there is only one"
      },
      "proposal": {
        "type": "boolean",
        "description": "Also report the bundle's proposal as the workspace shows it: the document, validation, approval, each pending suggestion checked, and the captured screens (ADR-116 §3). Runs the checks, so it is slower"
      }
    },
    "required": [],
    "x-positional": [
      "dir"
    ]
  },
  "output": {
    "type": "object",
    "required": [
      "flow",
      "title",
      "root",
      "steps",
      "next",
      "summary"
    ],
    "properties": {
      "flow": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "root": {
        "type": "string",
        "description": "The directory, resolved."
      },
      "steps": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "title",
            "kind",
            "state"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "optional",
                "command",
                "gate"
              ]
            },
            "state": {
              "type": "string",
              "enum": [
                "optional",
                "stale",
                "done",
                "next",
                "ready",
                "waiting",
                "blocked",
                "unavailable"
              ]
            },
            "detail": {
              "type": "string"
            },
            "command": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "next": {
        "description": "The command to run next, or null when nothing can run."
      },
      "summary": {
        "type": "string"
      },
      "proposal": {
        "type": "object",
        "required": [
          "proposal",
          "bundle",
          "app",
          "approval",
          "document",
          "validation",
          "valid",
          "suggestions",
          "screens"
        ],
        "properties": {
          "proposal": {
            "type": "string",
            "description": "The decomposition.yaml read."
          },
          "bundle": {
            "type": [
              "null",
              "string"
            ],
            "description": "The evidence bundle the screens' screenshot paths are relative to; null without one."
          },
          "app": {
            "type": "object",
            "required": [
              "name",
              "namespace"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "namespace": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "approval": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "none",
                  "current",
                  "stale"
                ]
              },
              "by": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "hash": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "document": {
            "type": "object",
            "required": [
              "version",
              "app",
              "domains",
              "shared",
              "unassigned",
              "couplings",
              "slots",
              "routes",
              "repeated",
              "tests",
              "uncovered"
            ],
            "properties": {
              "version": {
                "type": "number",
                "enum": [
                  1
                ]
              },
              "app": {
                "type": "object",
                "required": [
                  "name",
                  "namespace",
                  "gateway"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "namespace": {
                    "type": "string",
                    "description": "The control-plane namespace the derived composition owns (ADR-083)."
                  },
                  "gateway": {
                    "type": "boolean",
                    "description": "How the app's API URLs name backends: `/api/<backend>/<resource>` (a\ngateway) or `/api/<resource>` (one API). Judged by `backendLayout`."
                  }
                },
                "additionalProperties": false
              },
              "domains": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "mfe",
                    "shell",
                    "files",
                    "capabilities",
                    "backends",
                    "endpoints",
                    "evidence",
                    "reasons"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "mfe": {
                      "type": "string"
                    },
                    "shell": {
                      "type": "boolean",
                      "description": "The domain that provides the layout everything else composes into."
                    },
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "capabilities": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "name",
                          "file",
                          "component"
                        ],
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "file": {
                            "type": "string"
                          },
                          "component": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "backends": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Backend ids (the API path segment the app calls them under)."
                    },
                    "endpoints": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "`METHOD /path` the domain's files call, directly or through a store."
                    },
                    "evidence": {
                      "type": "object",
                      "required": [
                        "route",
                        "data",
                        "imports",
                        "runtime",
                        "cochange",
                        "ownership"
                      ],
                      "properties": {
                        "route": {
                          "type": [
                            "null",
                            "number"
                          ]
                        },
                        "data": {
                          "type": [
                            "null",
                            "number"
                          ]
                        },
                        "imports": {
                          "type": [
                            "null",
                            "number"
                          ]
                        },
                        "runtime": {
                          "type": [
                            "null",
                            "number"
                          ]
                        },
                        "cochange": {
                          "type": [
                            "null",
                            "number"
                          ]
                        },
                        "ownership": {
                          "type": [
                            "null",
                            "number"
                          ]
                        }
                      },
                      "additionalProperties": false,
                      "description": "Per-signal agreement with this boundary, 0–1; null where the signal is absent."
                    },
                    "reasons": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "shared": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "file",
                    "usedBy",
                    "suggestion"
                  ],
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "usedBy": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "suggestion": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "description": "Files several domains use; each needs splitting, duplicating or replacing, not an owner."
              },
              "unassigned": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Files no entry or route reaches."
              },
              "couplings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "file",
                    "domain",
                    "field",
                    "endpoint",
                    "owner",
                    "kind",
                    "note"
                  ],
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "domain": {
                      "type": "string"
                    },
                    "field": {
                      "type": "string"
                    },
                    "endpoint": {
                      "type": "string"
                    },
                    "owner": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "store-read",
                        "shell-read"
                      ]
                    },
                    "note": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "description": "A domain reading another domain's data through a shared store or the shell."
              },
              "slots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "provider",
                    "repeated"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "provider": {
                      "type": "string"
                    },
                    "repeated": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "routes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "stateKey",
                    "place"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "stateKey": {
                      "type": "string"
                    },
                    "place": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "capability",
                          "domain",
                          "slot"
                        ],
                        "properties": {
                          "capability": {
                            "type": "string"
                          },
                          "domain": {
                            "type": "string"
                          },
                          "slot": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "repeated": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "capability",
                    "domain",
                    "slot",
                    "renderedBy"
                  ],
                  "properties": {
                    "capability": {
                      "type": "string"
                    },
                    "domain": {
                      "type": "string"
                    },
                    "slot": {
                      "type": "string"
                    },
                    "renderedBy": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "description": "Placements made by the shell for each item of a list (one tile per berth): bound when composed."
              },
              "tests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "file",
                    "domain",
                    "verdict",
                    "reasons"
                  ],
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "domain": {
                      "type": [
                        "null",
                        "string"
                      ]
                    },
                    "verdict": {
                      "type": "string",
                      "enum": [
                        "keep",
                        "rewrite",
                        "discard"
                      ]
                    },
                    "reasons": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "uncovered": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "capability",
                    "domain",
                    "file",
                    "reason"
                  ],
                  "properties": {
                    "capability": {
                      "type": "string"
                    },
                    "domain": {
                      "type": "string"
                    },
                    "file": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "description": "Capabilities no kept test exercises."
              },
              "fileEndpoints": {
                "type": "object",
                "description": "`METHOD /path` each file calls or reads through a store, so a move or a\nsplit can recompute what each domain's BFF fronts. Absent in proposals\nwritten before the workspace (ADR-116)."
              },
              "comments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "by",
                    "at",
                    "text"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "by": {
                      "type": "string"
                    },
                    "at": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "about": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "description": "The conversation about the proposal, kept with it so the PR carries it (ADR-116 §3)."
              },
              "suggestions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "by",
                    "at",
                    "explanation",
                    "edit"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "by": {
                      "type": "string"
                    },
                    "at": {
                      "type": "string"
                    },
                    "explanation": {
                      "type": "string"
                    },
                    "edit": {},
                    "request": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "description": "Edits an agent proposed, waiting for a person to accept or reject them (ADR-116 §4)."
              },
              "approval": {
                "type": "object",
                "required": [
                  "by",
                  "at",
                  "hash"
                ],
                "properties": {
                  "by": {
                    "type": "string"
                  },
                  "at": {
                    "type": "string"
                  },
                  "hash": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "description": "Who approved, when, and a hash of what they approved (ADR-116 §5)."
              }
            },
            "additionalProperties": false
          },
          "validation": {
            "type": "object",
            "required": [
              "manifests",
              "composition"
            ],
            "properties": {
              "manifests": {
                "type": "object",
                "description": "MFE name → `path: message` for each manifest error."
              },
              "composition": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "message",
                    "rule"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "rule": {
                      "type": "string",
                      "enum": [
                        "namespace-escape",
                        "unknown-capability",
                        "ambiguous-capability",
                        "unknown-mfe",
                        "unbound-placeholder",
                        "undeclared-slot",
                        "undeclared-host"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "description": "Fatal composition findings."
              }
            },
            "additionalProperties": false
          },
          "valid": {
            "type": "boolean"
          },
          "suggestions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "by",
                "at",
                "explanation",
                "edit",
                "check"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "by": {
                  "type": "string"
                },
                "at": {
                  "type": "string"
                },
                "explanation": {
                  "type": "string"
                },
                "request": {
                  "type": "string"
                },
                "edit": {},
                "check": {
                  "type": "object",
                  "required": [
                    "ok",
                    "errors",
                    "domains"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "domains": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false,
                  "description": "The oracle's verdict (ADR-117 §4): the edit applied alone to the current document, then the fleet validated."
                }
              },
              "additionalProperties": false
            }
          },
          "screens": {
            "description": "Null without an evidence bundle to draw from."
          }
        },
        "additionalProperties": false,
        "description": "The proposal as the workspace reads it (ADR-116 §3); only with `--proposal`."
      }
    },
    "additionalProperties": false
  },
  "errorCodes": [
    0,
    1,
    2,
    64,
    65,
    66,
    69,
    70,
    77,
    124
  ]
}
