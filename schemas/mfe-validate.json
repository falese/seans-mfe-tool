{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seans-mfe.dev/schemas/mfe:validate.json",
  "title": "mfe:validate",
  "description": "Validate an MFE's internal consistency: manifest ⇄ package.json ⇄ federation shared config, declared slots are registered, lifecycle hook handlers resolve, native targets have their developer-owned files, and developer-owned code is checked for platform migrations (ADR-082). Read-only — reports issues with a file, line and fix, and exits non-zero on any error. Migration findings are warnings unless --strict. --typecheck also runs tsc. Validates one MFE directory, not a fleet (use compose:validate for a control plane).",
  "input": {
    "type": "object",
    "properties": {
      "dir": {
        "type": "string",
        "description": "MFE directory to validate (default: current directory)"
      },
      "typecheck": {
        "type": "boolean",
        "description": "Also run `tsc --noEmit` in the MFE directory"
      },
      "strict": {
        "type": "boolean",
        "description": "Fail on platform-migration warnings instead of reporting them (ADR-082)"
      }
    },
    "required": [],
    "x-positional": [
      "dir"
    ]
  },
  "output": {
    "type": "object",
    "required": [
      "mfe",
      "framework",
      "ok",
      "checked",
      "issues"
    ],
    "properties": {
      "mfe": {
        "type": "string"
      },
      "framework": {
        "type": "string"
      },
      "ok": {
        "type": "boolean"
      },
      "checked": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "issues": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "rule",
            "message"
          ],
          "properties": {
            "rule": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "package": {
              "type": "string"
            },
            "expected": {
              "type": "string"
            },
            "actual": {
              "type": "string"
            },
            "severity": {
              "type": "string",
              "enum": [
                "error",
                "warning"
              ],
              "description": "`warning` reports without failing; absent means `error` (ADR-082)."
            },
            "location": {
              "type": "string",
              "description": "`path:line`, for issues found in a specific source file."
            },
            "fix": {
              "type": "string",
              "description": "What to do about it, for rules that can say."
            }
          },
          "additionalProperties": false
        }
      },
      "typecheck": {
        "type": "object",
        "required": [
          "ran",
          "ok"
        ],
        "properties": {
          "ran": {
            "type": "boolean"
          },
          "ok": {
            "type": "boolean"
          },
          "output": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "errorCodes": [
    0,
    1,
    2,
    64,
    65,
    66,
    69,
    70,
    77,
    124
  ]
}
