{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seans-mfe.dev/schemas/decompose:edit.json",
  "title": "decompose:edit",
  "description": "Apply named edits to a decomposition.yaml — rename, merge or split domains, move a file, rename a capability or slot, comment, suggest, approve — keeping every reference consistent, then re-derive and validate the fleet (ADR-110, ADR-116).",
  "input": {
    "type": "object",
    "properties": {
      "proposal": {
        "type": "string",
        "description": "The decomposition.yaml to edit"
      },
      "rename-domain": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "from=to"
      },
      "merge": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "a,b[,…]=into — merge domains into one"
      },
      "split": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "domain=into:file[,file…] — split files out of a domain into a new one"
      },
      "move": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "file=domain — move a file (and any capability it holds); domain may be \"shared\""
      },
      "rename-capability": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "from=to"
      },
      "rename-slot": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "from=to"
      },
      "ops": {
        "type": "string",
        "description": "Named edits as a JSON list (or @file): any edit kind, including comment, suggest, accept-suggestion, reject-suggestion and approve"
      },
      "dry-run": {
        "type": "boolean",
        "description": "Apply and validate the edits, but write nothing"
      }
    },
    "required": [
      "proposal"
    ],
    "x-positional": [
      "proposal"
    ]
  },
  "output": {
    "type": "object",
    "required": [
      "proposal",
      "edits",
      "domains",
      "approval",
      "suggestions",
      "validation",
      "valid",
      "dryRun",
      "files"
    ],
    "properties": {
      "proposal": {
        "type": "string"
      },
      "edits": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "domains": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "approval": {
        "type": "string",
        "enum": [
          "none",
          "current",
          "stale"
        ],
        "description": "Whether a recorded approval still names the edited document (ADR-116 §5)."
      },
      "suggestions": {
        "type": "number",
        "description": "Agent suggestions still waiting for a decision."
      },
      "validation": {
        "type": "object",
        "required": [
          "manifests",
          "composition"
        ],
        "properties": {
          "manifests": {
            "type": "object"
          },
          "composition": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "rule",
                "message"
              ],
              "properties": {
                "rule": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "valid": {
        "type": "boolean"
      },
      "dryRun": {
        "type": "boolean",
        "description": "True when the edits were only applied and validated, not written (ADR-117 §4)."
      },
      "files": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "What was written; empty on a dry run."
      }
    },
    "additionalProperties": false
  },
  "errorCodes": [
    0,
    1,
    2,
    64,
    65,
    66,
    69,
    70,
    77,
    124
  ]
}
