{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seans-mfe.dev/schemas/test:host.json",
  "title": "test:host",
  "description": "Serve an MFE's capabilities, each mounted by the platform as a shell mounts it, on one page: what test:crawl and test:generate --host record, and its journey spec replays against, in any framework (ADR-129). Runs until interrupted.",
  "input": {
    "type": "object",
    "properties": {
      "mfe": {
        "type": "string",
        "description": "The MFE directory"
      },
      "remote": {
        "type": "string",
        "description": "The origin the MFE is served from (default: its manifest's remoteEntry)"
      },
      "port": {
        "type": "string",
        "description": "The port to serve the host on",
        "default": 5180
      }
    },
    "required": [
      "mfe"
    ],
    "x-positional": [
      "mfe"
    ]
  },
  "output": {
    "type": "object",
    "required": [
      "mfe",
      "url",
      "capabilities",
      "remoteEntryUrl"
    ],
    "properties": {
      "mfe": {
        "type": "string"
      },
      "url": {
        "type": "string"
      },
      "capabilities": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "remoteEntryUrl": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "errorCodes": [
    0,
    1,
    2,
    64,
    65,
    66,
    69,
    70,
    77,
    124
  ]
}
