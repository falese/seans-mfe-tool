{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seans-mfe.dev/schemas/remote:init.json",
  "title": "remote:init",
  "description": "Initialize a new DSL-first remote MFE project",
  "input": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Remote MFE name"
      },
      "framework": {
        "type": "string",
        "description": "Framework to use (default: react). Install @seans-mfe/framework-<name> for third-party frameworks.",
        "default": "react"
      },
      "port": {
        "type": "string",
        "description": "Port number for the remote MFE (default: per-framework)"
      },
      "force": {
        "type": "boolean",
        "description": "Overwrite existing files"
      },
      "dry-run": {
        "type": "boolean",
        "description": "Preview changes without writing"
      }
    },
    "required": [
      "name"
    ],
    "x-positional": [
      "name"
    ]
  },
  "output": {
    "type": "object",
    "required": [
      "name",
      "port",
      "targetDir",
      "generatedFiles",
      "dryRun"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "port": {
        "type": "number"
      },
      "targetDir": {
        "type": "string"
      },
      "generatedFiles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "dryRun": {
        "type": "boolean"
      },
      "plannedChanges": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "op",
            "target"
          ],
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "create",
                "overwrite",
                "reseed",
                "skip",
                "spawn"
              ],
              "description": "`overwrite` re-stamps a generator-owned file; `skip` leaves a\ndeveloper-owned one alone. `reseed` is the third outcome ADR-089 adds —\na developer-owned file that exists and WILL be replaced because `--force`\nwas passed. It is distinct from `overwrite` because it is the only op that\ncan destroy work, and a dry run that calls it `overwrite` hides that."
            },
            "target": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "errorCodes": [
    0,
    1,
    2,
    64,
    65,
    66,
    69,
    70,
    77,
    124
  ]
}
