{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seans-mfe.dev/schemas/remote:init.json",
  "title": "remote:init",
  "description": "Initialize a new DSL-first remote MFE project",
  "input": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Remote MFE name"
      },
      "dry-run": {
        "type": "boolean",
        "description": "Preview changes without writing them"
      },
      "framework": {
        "type": "string",
        "description": "Framework to use (default: react). Install @falese/smt-framework-<name> for third-party frameworks.",
        "default": "react"
      },
      "port": {
        "type": "string",
        "description": "Port number for the remote MFE (default: per-framework)"
      },
      "template": {
        "type": "string",
        "description": "Path to DSL template file"
      },
      "skip-install": {
        "type": "boolean",
        "description": "Skip npm install"
      },
      "force": {
        "type": "boolean",
        "description": "Overwrite existing files"
      }
    },
    "required": [
      "name"
    ],
    "x-positional": [
      "name"
    ]
  },
  "output": {
    "type": "object",
    "required": [
      "name",
      "port",
      "targetDir",
      "generatedFiles",
      "dryRun"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "port": {
        "type": "number"
      },
      "targetDir": {
        "type": "string"
      },
      "generatedFiles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "dryRun": {
        "type": "boolean"
      },
      "plannedChanges": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "op",
            "target"
          ],
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "create",
                "overwrite",
                "skip",
                "spawn"
              ]
            },
            "target": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "errorCodes": [
    0,
    1,
    2,
    64,
    65,
    66,
    69,
    70,
    77,
    124
  ]
}
