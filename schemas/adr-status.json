{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seans-mfe.dev/schemas/adr:status.json",
  "title": "adr:status",
  "description": "Show ADR lifecycle state — what is proposed, outstanding, or done (ADR-075)",
  "input": {
    "type": "object",
    "properties": {
      "dir": {
        "type": "string",
        "description": "Repo root holding docs/architecture-decisions (default: search upward from cwd)"
      },
      "outstanding": {
        "type": "boolean",
        "description": "Only decisions that are ratified with work still to do"
      },
      "status": {
        "type": "string",
        "description": "Filter to one status (Proposed, Accepted, Implemented, Deferred, Superseded, Withdrawn); case-insensitive"
      }
    },
    "required": [],
    "x-positional": [
      "dir"
    ]
  },
  "output": {
    "type": "object",
    "required": [
      "total",
      "counts",
      "outstanding",
      "entries"
    ],
    "properties": {
      "total": {
        "type": "number"
      },
      "counts": {
        "type": "object"
      },
      "outstanding": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "title",
            "status",
            "area",
            "refs",
            "implementedBy"
          ],
          "properties": {
            "id": {
              "type": "number"
            },
            "title": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "Proposed",
                "Accepted",
                "Implemented",
                "Deferred",
                "Superseded",
                "Withdrawn"
              ]
            },
            "area": {
              "type": "string"
            },
            "stage": {
              "type": "string",
              "description": "`phased` / `deferred` when work is outstanding."
            },
            "refs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Issues tracking the outstanding work."
            },
            "implementedBy": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "description": "Ratified but not finished — the actionable list."
      },
      "entries": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "title",
            "status",
            "area",
            "refs",
            "implementedBy"
          ],
          "properties": {
            "id": {
              "type": "number"
            },
            "title": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "Proposed",
                "Accepted",
                "Implemented",
                "Deferred",
                "Superseded",
                "Withdrawn"
              ]
            },
            "area": {
              "type": "string"
            },
            "stage": {
              "type": "string",
              "description": "`phased` / `deferred` when work is outstanding."
            },
            "refs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Issues tracking the outstanding work."
            },
            "implementedBy": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "errorCodes": [
    0,
    1,
    2,
    64,
    65,
    66,
    69,
    70,
    77,
    124
  ]
}
