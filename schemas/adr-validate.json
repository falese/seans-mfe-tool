{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seans-mfe.dev/schemas/adr:validate.json",
  "title": "adr:validate",
  "description": "Validate the ADR library's metadata, cross-references, and code citations (ADR-075)",
  "input": {
    "type": "object",
    "properties": {
      "dir": {
        "type": "string",
        "description": "Repo root holding docs/architecture-decisions (default: search upward from cwd)"
      },
      "include-examples": {
        "type": "boolean",
        "description": "Also scan examples/** for ADR citations (44 files carry pre-reflow numbers)"
      }
    },
    "required": [],
    "x-positional": [
      "dir"
    ]
  },
  "output": {
    "type": "object",
    "required": [
      "adrs",
      "ok",
      "checked",
      "issues"
    ],
    "properties": {
      "adrs": {
        "type": "number"
      },
      "ok": {
        "type": "boolean"
      },
      "checked": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "frontmatter-valid",
            "metadata-complete",
            "reference-resolves",
            "reference-gloss-matches",
            "supersession-bidirectional",
            "implemented-by-exists",
            "code-cites-ratified-adr",
            "register-complete",
            "accepted-work-is-tracked",
            "implemented-claims-evidence",
            "finished-work-says-so"
          ]
        }
      },
      "issues": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "rule",
            "file",
            "message"
          ],
          "properties": {
            "rule": {
              "type": "string",
              "enum": [
                "frontmatter-valid",
                "metadata-complete",
                "reference-resolves",
                "reference-gloss-matches",
                "supersession-bidirectional",
                "implemented-by-exists",
                "code-cites-ratified-adr",
                "register-complete",
                "accepted-work-is-tracked",
                "implemented-claims-evidence",
                "finished-work-says-so"
              ]
            },
            "file": {
              "type": "string",
              "description": "Repo-relative path of the file the issue is in."
            },
            "line": {
              "type": "number",
              "description": "1-indexed line, when the finding is anchored to one."
            },
            "message": {
              "type": "string"
            },
            "expected": {
              "type": "string"
            },
            "actual": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "errorCodes": [
    0,
    1,
    2,
    64,
    65,
    66,
    69,
    70,
    77,
    124
  ]
}
