{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seans-mfe.dev/schemas/deploy.json",
  "title": "deploy",
  "description": "Deploy an application to a local development container",
  "input": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Application name"
      },
      "dry-run": {
        "type": "boolean",
        "description": "Preview changes without writing them"
      },
      "type": {
        "type": "string",
        "enum": [
          "shell",
          "remote",
          "api"
        ],
        "description": "Application type (shell, remote, or api)"
      },
      "env": {
        "type": "string",
        "description": "Deployment environment (development; production is not yet implemented — see ADR-062)",
        "default": "development"
      },
      "port": {
        "type": "string",
        "description": "Port number for development deployment",
        "default": "8080"
      }
    },
    "required": [
      "name",
      "type"
    ],
    "x-positional": [
      "name"
    ]
  },
  "output": {
    "type": "object",
    "required": [
      "appName",
      "environment",
      "ports",
      "generatedFiles",
      "dryRun"
    ],
    "properties": {
      "appName": {
        "type": "string"
      },
      "environment": {
        "type": "string",
        "enum": [
          "development",
          "production"
        ]
      },
      "containerId": {
        "type": "string"
      },
      "ports": {
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "generatedFiles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "mode": {
        "type": "string"
      },
      "dryRun": {
        "type": "boolean"
      },
      "plannedChanges": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "op",
            "target"
          ],
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "create",
                "overwrite",
                "skip",
                "spawn"
              ]
            },
            "target": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "errorCodes": [
    0,
    1,
    2,
    64,
    65,
    66,
    69,
    70,
    77,
    124
  ]
}
